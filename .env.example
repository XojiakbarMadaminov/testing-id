MOCK_PUBLIC_BASE_URL=http://localhost:8089
MOCK_DATA_DIR=.local/data
MOCK_PORT=8089
MOCK_CODE_TTL=60
MOCK_ACCESS_TTL=300
MOCK_REFRESH_TTL=86400
MOCK_BROWSER_TTL=3600
MOCK_LOGIN_TTL=300
# Independent mock-only exceptions for exact registered localhost callbacks.
MOCK_ALLOW_HTTPS_LOCALHOST_CALLBACKS=false
MOCK_ALLOW_HTTP_LOCALHOST_CALLBACKS=false
# Exact HTTP frontend hosts: petition.local and cabinet-petition.local.
MOCK_ALLOW_HTTP_LOCAL_DOMAINS=false
# Exact final frontend origins for CSP form-action redirect chains.
MOCK_FRONTEND_ORIGINS=https://petition.dgov-uic.uz,https://cabinet-petition.dgov-uic.uz,https://localhost:5173

